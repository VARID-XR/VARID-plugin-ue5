#pragma once

#include "../VARIDCommon.ush"

Texture2D InSceneColorSRV;
float InBlurStrength;
float InContrastReduction;
float InBrightThreshold;
float InGlareStrength;

void MainPS
(
    in noperspective float4 UVAndScreenPos : TEXCOORD0,
    out float4 OutColor : SV_Target0
)
{
    float4 SceneColor = InSceneColorSRV.SampleLevel(View.SharedTrilinearClampedSampler, UVAndScreenPos.xy, InBlurStrength);

    // Compute how bright the original pixel is
    float Brightness = max(SceneColor.r, max(SceneColor.g, SceneColor.b));
    float GlareFactor = saturate((Brightness - InBrightThreshold) / (1.0 - InBrightThreshold));

    // Add glare from blurred texture
    float3 ColorWithGlare = SceneColor.rgb * GlareFactor * InGlareStrength;

    // Reduce contrast globally
    float3 FinalColor = ApplyContrast(ColorWithGlare, InContrastReduction);

    OutColor = float4(FinalColor, SceneColor.a);
}